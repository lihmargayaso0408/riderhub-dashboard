{
  "manifest_version": 3,
  "name": "SPX Bridge — Rider Performance System",
  "version": "1.0.0",
  "description": "Pulls the Driver LM Performance Report from SPX (spx.shopee.ph) into the Rider Performance System dashboard.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": ["https://spx.shopee.ph/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://spx.shopee.ph/*"],
      "js": ["spx-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://spx.shopee.ph/*"],
      "js": ["spx-content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
      "exclude_matches": ["https://spx.shopee.ph/*"],
      "js": ["dashboard-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dashboard-main.js"],
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"]
    }
  ]
}
